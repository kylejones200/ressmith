# Include important files for PyPI distribution
include README.md
include LICENSE
include pyproject.toml

# Package source only
recursive-include ressmith *.py

# Tests/examples in the sdist for contributors (not installed via wheel packages)
recursive-include tests *.py
recursive-include examples *.py

# Never ship these
prune htmlcov
prune .venv
prune .pytest_cache
prune .git
prune .github

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude .git*
global-exclude .venv*
global-exclude *.png
global-exclude *.pth
global-exclude *.save
global-exclude *.egg-info
